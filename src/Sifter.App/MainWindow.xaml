<Window x:Class="Sifter.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Sifter" Width="1180" Height="760" MinWidth="960" MinHeight="620"
        WindowStartupLocation="CenterScreen">
    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Top" Background="{StaticResource AppPanelBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="18,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Image Width="40" Height="40" Source="Assets/Sifter.ico" Margin="0,0,14,0"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Sifter" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock x:Name="BuildInfoText" Foreground="{StaticResource AppMutedTextBrush}" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="LaunchStableButton" Content="Launch Stable Sifter" Style="{StaticResource PrimaryButtonStyle}"/>
                    <Button x:Name="OpenRepositoryButton" Content="GitHub"/>
                </StackPanel>
            </Grid>
        </Border>

        <StatusBar DockPanel.Dock="Bottom" Background="{StaticResource AppPanelBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusText" Text="Ready"/>
        </StatusBar>

        <TabControl Margin="14">
            <TabItem Header="Dashboard">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="{StaticResource AppPanelBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" Padding="16" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="Runtime" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="App data" Foreground="{StaticResource AppMutedTextBrush}" Margin="0,0,10,8"/>
                                <TextBox x:Name="AppDataPathText" Grid.Column="1" IsReadOnly="True" Margin="0,0,0,8"/>
                                <TextBlock Text="Cache" Grid.Row="1" Foreground="{StaticResource AppMutedTextBrush}" Margin="0,0,10,8"/>
                                <TextBox x:Name="CachePathText" Grid.Row="1" Grid.Column="1" IsReadOnly="True" Margin="0,0,0,8"/>
                                <TextBlock Text="Logs" Grid.Row="2" Foreground="{StaticResource AppMutedTextBrush}" Margin="0,0,10,8"/>
                                <TextBox x:Name="LogPathText" Grid.Row="2" Grid.Column="1" IsReadOnly="True" Margin="0,0,0,8"/>
                                <TextBlock Text="Stable app" Grid.Row="3" Foreground="{StaticResource AppMutedTextBrush}" Margin="0,0,10,0"/>
                                <TextBox x:Name="StableScriptPathText" Grid.Row="3" Grid.Column="1" IsReadOnly="True"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button x:Name="OpenAppDataButton" Content="Open App Data"/>
                                <Button x:Name="OpenStableFolderButton" Content="Open Stable Folder"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Background="{StaticResource AppPanelBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Next Build" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,10"/>
                            <TextBlock Text="Core library" Margin="0,0,0,8"/>
                            <ProgressBar Height="8" Minimum="0" Maximum="100" Value="25" Margin="0,0,0,14"/>
                            <TextBlock Text="Native WPF shell" Margin="0,0,0,8"/>
                            <ProgressBar Height="8" Minimum="0" Maximum="100" Value="20" Margin="0,0,0,14"/>
                            <TextBlock Text="Scanner port" Margin="0,0,0,8"/>
                            <ProgressBar Height="8" Minimum="0" Maximum="100" Value="0" Margin="0,0,0,14"/>
                            <TextBlock Text="Exporter port" Margin="0,0,0,8"/>
                            <ProgressBar Height="8" Minimum="0" Maximum="100" Value="0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="Library">
                <Grid Margin="0,12,0,0">
                    <DataGrid AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="System" Width="120"/>
                            <DataGridTextColumn Header="Game" Width="*"/>
                            <DataGridTextColumn Header="Score" Width="90"/>
                            <DataGridTextColumn Header="Size" Width="110"/>
                            <DataGridCheckBoxColumn Header="Selected" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="Export">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Preview"/>
                        <Button Content="Copy Selected" Style="{StaticResource PrimaryButtonStyle}"/>
                        <Button Content="Cancel"/>
                    </StackPanel>
                    <TextBox Grid.Row="1" Margin="0,12,0,0" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                </Grid>
            </TabItem>
            <TabItem Header="Maintenance">
                <StackPanel Margin="0,12,0,0">
                    <Button Content="Refresh Cache" Width="150" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                    <Button Content="Open Logs" Width="150" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                    <Button Content="Update Ratings" Width="150" HorizontalAlignment="Left"/>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
