<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Sifter.Core\Sifter.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>Sifter</AssemblyName>
    <RootNamespace>Sifter.App</RootNamespace>
    <ApplicationIcon>..\..\assets\Sifter.ico</ApplicationIcon>
    <Version>0.4.0</Version>
    <FileVersion>0.4.0.0</FileVersion>
    <AssemblyVersion>0.4.0.0</AssemblyVersion>
    <Product>Sifter</Product>
    <Company>710breadman</Company>
    <Description>Sifter Windows desktop app</Description>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="..\..\assets\Sifter.ico" Link="Assets\Sifter.ico" />
    <Content Include="..\..\Run-RomCurator.ps1" Link="Stable\Run-RomCurator.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="..\..\RomCurator.Core.psm1" Link="Stable\RomCurator.Core.psm1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="..\..\assets\Sifter.ico" Link="Stable\assets\Sifter.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="..\..\assets\Sifter.png" Link="Stable\assets\Sifter.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="..\..\data\**\*" Link="Stable\data\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="..\..\tools\Build-Metacritic-Critic-Scores.ps1" Link="Stable\tools\Build-Metacritic-Critic-Scores.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

</Project>
